# The public production URL used for canonical tags, sitemap.xml and robots.txt.
# Use the final HTTPS domain without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend email delivery. Never commit real values to this file.
RESEND_API_KEY=re_your_resend_api_key
ENQUIRY_TO_EMAIL=enquiries@example.com
# This must be an address on a domain verified in your Resend account.
ENQUIRY_FROM_EMAIL="Zazu Adventures <enquiries@example.com>"
